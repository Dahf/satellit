# Kopieren nach .env — wird von docker compose gelesen (beide Container).

# Pushover (pushover.net)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Dashboard
DASHBOARD_PASSWORD=            # Login-Passwort, lang und zufällig
SESSION_SALT=                  # beliebige Zufallszeichenkette (macht das Session-Cookie einmalig)
SATELLIT_API_TOKEN=            # geteiltes Geheimnis Dashboard <-> Python-API, z. B. `openssl rand -hex 32`
DASHBOARD_URL=                 # optional, z. B. https://satellit.example.de — landet als Link in der Push-Nachricht

# Optional
STOOQ_APIKEY=                  # Fallback-Kursquelle (Key per Captcha auf stooq.com)
SATELLIT_TZ=Europe/Berlin
